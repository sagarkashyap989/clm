NODE_ENV=production
PORT=5000

# Public URL people type in the browser (no trailing slash).
# HTTP example: http://203.0.113.10
# HTTPS example: https://cml.example.com
CLIENT_URL=http://YOUR_SERVER_IP

# Keep false until the site is served over HTTPS.
COOKIE_SECURE=false

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

INVITATION_EXPIRES_DAYS=7

# Optional. Leave as-is to skip mail (register still works; invites will not arrive).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASS=
